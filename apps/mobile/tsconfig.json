{
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "nativewind-env.d.ts",
    "global.d.ts",
    "expo-env.d.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "Bundler",
    "allowJs": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*", "./*"],
      "@convex/*": ["./convex/*"],
      "@root/*": ["./*"]
    }
  }
}

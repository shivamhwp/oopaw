{
	"name": "t3s-agent",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"build:web": "turbo run build --filter=web",
		"check": "turbo run check",
		"convex": "bunx convex dev",
		"dev": "turbo run convex web#dev mobile#dev --parallel",
		"dev:mobile": "turbo run convex mobile#dev --parallel",
		"web": "turbo run web#dev",
		"mobile": "turbo run mobile#dev",
		"dev:web": "turbo run convex web#dev --parallel",
		"install:web": "cd apps/web && bun install",
		"install:mobile": "cd apps/mobile && bun install",
		"rm:nm:web": "rm -rf apps/web/node_modules",
		"rm:nm:mobile": "rm -rf apps/mobile/node_modules",
		"format": "turbo run format",
		"format:web": "turbo run format --filter=web",
		"format:mobile": "turbo run format --filter=mobile",
		"typecheck": "turbo run typecheck",
		"typecheck:web": "turbo run typecheck --filter=web",
		"typecheck:mobile": "turbo run typecheck --filter=mobile"
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260311.1",
		"convex": "^1.33.1",
		"turbo": "^2.8.14"
	},
	"resolutions": {
		"hermes-compiler": "250829098.0.4",
		"lightningcss": "1.30.1"
	},
	"overrides": {
		"hermes-compiler": "250829098.0.4",
		"lightningcss": "1.30.1"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.10"
}

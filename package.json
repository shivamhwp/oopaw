{
  "name": "t3s-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "check": "turbo run check",
    "convex": "bunx convex dev",
    "dev": "concurrently --kill-others-on-fail -n convex,web -c magenta,cyan --prefix \"{name}\" --pad-prefix \"bunx convex dev\" \"bun --filter web dev\"",
    "dev:web": "concurrently --kill-others-on-fail -n convex,web -c magenta,cyan --prefix \"{name}\" --pad-prefix \"bunx convex dev\" \"bun --filter web dev\"",
    "dev:mobile": "concurrently --kill-others-on-fail -n convex,mobile -c magenta,yellow --prefix \"{name}\" --pad-prefix \"bunx convex dev\" \"bun --filter mobile dev\"",
    "android": "bun --filter mobile android",
    "ios": "bun --filter mobile ios",
    "web": "bun --filter web dev",
    "mobile": "bun --cwd apps/mobile expo start --clear",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "format:web": "turbo run format --filter=web",
    "format:mobile": "turbo run format --filter=mobile",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "quality": "turbo run lint format",
    "quality:fix": "turbo run lint:fix format:fix",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=web",
    "typecheck:mobile": "turbo run typecheck --filter=mobile",
    "knip": "knip --no-config-hints"
  },
  "dependencies": {
    "react": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "convex": "^1.33.1",
    "knip": "^5.87.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "hermes-compiler": "250829098.0.4",
    "lightningcss": "1.30.1"
  },
  "overrides": {
    "hermes-compiler": "250829098.0.4",
    "lightningcss": "1.30.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.10"
}

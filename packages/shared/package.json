{
  "name": "@repo/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./feed/*": "./src/feed/*.ts"
  },
  "scripts": {
    "check": "concurrently --kill-others-on-fail --names fmt,lint,types \"oxfmt --check .\" \"oxlint .\" \"bun run typecheck\"",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.5",
    "html-entities": "^2.6.0",
    "sanitize-html": "^2.17.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.5.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native-preview": "^7.0.0-dev.20260315.1",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0"
  }
}

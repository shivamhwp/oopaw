{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "check": "oxfmt --check . && oxlint --react-plugin src && tsgo --noEmit",
    "format": "oxfmt --write .",
    "lint": "oxlint --react-plugin src",
    "lint:fix": "oxlint --react-plugin --fix src",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "generate:component": "turbo gen react-component",
    "typecheck": "tsgo --noEmit",
    "check-types": "tsgo --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript/native-preview": "^7.0.0-dev.20260309.1",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "typescript": "5.9.2"
  }
}
